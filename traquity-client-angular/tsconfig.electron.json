/* Type-checks the Electron main process (JSDoc-typed CommonJS, see electron/LLM.md). Run via `npm run test:electron`. */
{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "allowJs": true,
    "checkJs": true,
    "module": "node16",
    "moduleResolution": "node16",
    "target": "ES2023",
    "lib": [
      "ES2023"
    ],
    "types": [
      "node"
    ],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true
  },
  "include": [
    "electron/**/*.js"
  ]
}
